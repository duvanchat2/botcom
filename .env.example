# botcom — variables de entorno (PLANTILLA). Copia a /root/.hermes/.env y rellena.
# NUNCA subas el .env real al repositorio.

# --- Cerebro: OpenRouter ---
OPENROUTER_API_KEY=sk-or-xxxxxxxxxxxxxxxxxxxxxxxx
# (config.yaml de Hermes: provider openrouter, base_url https://openrouter.ai/api/v1,
#  model p.ej. anthropic/claude-haiku-4.5, max_tokens 1024)

# --- WhatsApp: Kapso ---
KAPSO_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxx
KAPSO_PHONE_NUMBER_ID=1234567890123456
KAPSO_WEBHOOK_SECRET=generado_por_hermes_kapso_setup
KAPSO_HOME_CHANNEL=57XXXXXXXXXX

# --- Base de datos (rol de permisos minimos bot_ventas) ---
NS_DB_URL=postgresql://bot_ventas:CAMBIA_ESTA_CONTRASENA@127.0.0.1:5433/postgres

# --- Telegram: SOLO avisos (NO usar TELEGRAM_BOT_TOKEN: Hermes levantaria un
#     gateway de Telegram que hace polling y falla) ---
NS_TG_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NS_TG_CHAT=-100XXXXXXXXXX
